from astropy.cosmology import Planck18 as cosmo
import astropy.units as u
import pandas as pd

# BNS rate density bounds from LVK: in Gpc^-3 yr^-1
rate_density_bounds = {
    "low": 2.8,
    "high": 480,
    "fiducial": 100  # user-chosen mid-range value
}

# Convert to Mpc^-3 yr^-1
rate_density_bounds_mpc = {k: v * 1e-9 for k, v in rate_density_bounds.items()}

# Comoving volume up to z = 0.1, 0.2, 0.3, 0.5, and 0.6 (rough Rubin BNS limits)
redshifts = [0.1, 0.2, 0.3, 0.5, 0.6]
volumes = {z: cosmo.comoving_volume(z).to(u.Mpc**3).value for z in redshifts}

# Sky coverage factor: Rubin WFD is ~18,000 deg^2 out of 41,253
sky_fraction = 18000 / 41253

# Compute expected BNS events over 10 years
results = {}
years = 10

for z, V in volumes.items():
    for rate_key, rate_val in rate_density_bounds_mpc.items():
        N = rate_val * V * sky_fraction * years
        results[(rate_key, z)] = N


from astropy.cosmology import Planck18 as cosmo
import astropy.units as u

# O3 rate densities in Gpc^-3 yr^-1
rates_gpc3_yr = {
    "pessimistic": 21.6,
    "median": 105.5,
    "optimistic": 295.7
}

# Convert to Mpc^-3 yr^-1
rates_mpc3_yr = {k: v * 1e-9 for k, v in rates_gpc3_yr.items()}

# Define max redshift and LSST survey coverage fraction
z = 0.3
sky_fraction = 18000 / 41253
years = 10

# Get comoving volume out to redshift z
comoving_vol = cosmo.comoving_volume(z).to(u.Mpc**3).value

# Compute expected events over 10 years within LSST footprint
expected_events = {k: r * comoving_vol * sky_fraction * years for k, r in rates_mpc3_yr.items()}

print(expected_events)




